	(footprint "rcm:TerminalBlock_KF2EDG-3.5-2P_1x02_P3.50mm_Horizontal"
		(layer "F.Cu")
		(uuid "126adea8-78a0-4e57-bcb0-dc6b84803aac")
		(at 10 5 180)
		(descr "KF2EDGVM-3.5-2P PCB screw terminal block, 2 poles, 3.5mm pitch, horizontal wire entry. Body 7 x 7.6 x 9mm, pin centreline 3.4mm from the rear face and 4.2mm from the wire-entry face. PCB hole 1.2mm. pluggable header, mates KF2EDGK-3.5 screw plug, 8A 300V 16-24AWG. LCSC C441407. Wire entry faces +Y -- rotate so it points off the board edge, or the harness has to run back across the board.")
