	(footprint "rcm:TerminalBlock_KF2EDG-3.5-3P_1x03_P3.50mm_Horizontal"
		(layer "F.Cu")
		(uuid "0c3e6f5d-61f2-4047-b965-85f468157663")
		(at 70 5 180)
		(descr "KF2EDGVM-3.5-3P PCB screw terminal block, 3 poles, 3.5mm pitch, horizontal wire entry. Body 10.5 x 7.6 x 9mm, pin centreline 3.4mm from the rear face and 4.2mm from the wire-entry face. PCB hole 1.2mm. pluggable header, mates KF2EDGK-3.5 screw plug, 8A 300V 16-24AWG. LCSC C441407. Wire entry faces +Y -- rotate so it points off the board edge, or the harness has to run back across the board.")
